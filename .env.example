# Database Configuration (Remote PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# H2 Fallback Database (Local Offline Mode)
# When PostgreSQL is unavailable, the app falls back to a local H2 database.
# Data is automatically synced back to PostgreSQL when it recovers.
H2_DB_PATH=./data/college_fallback
H2_ENABLED=true
# Snapshot interval (PostgreSQL -> H2) in minutes. Set to 0 to disable.
PG_TO_H2_SYNC_INTERVAL_MINUTES=60

# API Keys
GOOGLE_API_KEY=your_google_api_key_here
DROPBOX_ACCESS_TOKEN=your_dropbox_token_here

# Security Note:
# 1. Copy this file to .env and update with your actual credentials
# 2. Never commit .env to version control if it contains real secrets
