# Database Configuration (Remote PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# H2 Fallback Database (Local Offline Mode)
# When PostgreSQL is unavailable, the app falls back to a local H2 database.
# Data is automatically synced back to PostgreSQL when it recovers.
H2_DB_PATH=./data/college_fallback
H2_ENABLED=true
# Snapshot interval (PostgreSQL -> H2) in minutes. Set to 0 to disable.
PG_TO_H2_SYNC_INTERVAL_MINUTES=60

# Web API security
# PORT is supplied automatically by hosts such as Render; local default is 7000.
# PORT=10000
API_TOKEN_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys
GOOGLE_API_KEY=your_google_api_key_here
DROPBOX_ACCESS_TOKEN=your_dropbox_token_here

# OpenRouter AI drafting (F1 assignment generator, A2 announcement drafter)
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_PRIMARY_MODEL=z-ai/glm-5.3-flash
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_TIMEOUT_MS=30000

# TokenRa Ox Alpha (primary provider; OpenRouter is the secondary).
# Get a key at https://tokenra.io/register — if unset, OpenRouter is used directly.
TOKENRA_API_KEY=your_tokenra_api_key_here
TOKENRA_API_URL=https://tokenra.io/v1/chat/completions
TOKENRA_MODEL=stealth/ox-alpha
TOKENRA_MAX_TOKENS=1500
TOKENRA_TIMEOUT_MS=25000

# Security Note:
# 1. Copy this file to .env and update with your actual credentials
# 2. Never commit .env to version control if it contains real secrets
